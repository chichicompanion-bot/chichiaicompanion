# NEXUS HEALTH — Environment Variables Configuration
# Copy this file to .env.local to customize Live ESP32 Backend connection

# REST API Endpoint for receiving/polling ESP32 + MAX30102 health telemetry
VITE_HEALTH_API_URL=/api/telemetry

# Optional WebSocket Endpoint for real-time sub-second streaming from ESP32 gateway
VITE_HEALTH_WS_URL=

# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=5000
